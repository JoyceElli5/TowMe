# TowMe Expo App Environment Variables
# Copy this file to .env and fill in your values

# Backend API URL
EXPO_PUBLIC_API_URL=http://localhost:3001/api

# Supabase Configuration (Client-side - SAFE to expose)
# These use EXPO_PUBLIC_ prefix to be accessible in Expo/React Native
EXPO_PUBLIC_SUPABASE_URL=your_supabase_project_url
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# IMPORTANT: NEVER put the service role key here!
# The service role key should ONLY be used on the backend server.
