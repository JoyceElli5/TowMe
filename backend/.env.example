# Supabase Configuration
SUPABASE_URL=your_supabase_project_url
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
# JWT secret from Supabase Dashboard > Settings > API > JWT Settings
SUPABASE_JWT_SECRET=your_supabase_jwt_secret

# JWT Configuration (for backend-generated tokens)
JWT_SECRET=your_jwt_secret_key_min_32_characters_long
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# Server Configuration
PORT=3001
NODE_ENV=development

# CORS Configuration
CORS_ORIGIN=http://localhost:8081

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000
AUTH_RATE_LIMIT_MAX_REQUESTS=100

# Admin dashboard login (email/password set here; use these to sign in in the admin app)
ADMIN_SECRET=towme-admin-dev-secret-2024
ADMIN_EMAIL=admin@towme.com
ADMIN_PASSWORD=your-secure-password



